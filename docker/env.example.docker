# env file is designed to be used by the docker-compose file
# rename file to .env 

MINIO_ROOT_PASSWORd=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ASSET_PREFIX=

NEXTAUTH_REDIRECT_URL=
NEXTAUTH_SECRET=
# JSON array; empty or [] disables OIDC providers.
# Use PROVIDER_ID="oidc" for the original IdP to retain existing account links.
# OIDC_CLIENTS='[{"ISSUER_URL":"https://idp.example.org","CLIENT_ID":"selflearn","CLIENT_SECRET":"secret","PROVIDER_NAME":"SSO","PROVIDER_ID":"oidc"}]'
OIDC_CLIENTS=
OIDC_SCOPES="openid profile email"

# Existing "keycloak" account links are migrated to provider ID "oidc".

POSTGRES_PASSWORD=
NEXT_PUBLIC_ONLINE_HELP_LANGUAGES="en,de"
NEXT_PUBLIC_ONLINE_HELP_BASE_URL="https://your-help-base-url"
