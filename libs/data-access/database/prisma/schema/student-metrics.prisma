view StudentMetric_LearningTime {
    userId      String  @unique
    username    String
    timeSeconds Decimal
}

view StudentMetric_DailyLearningTime {
    userId      String
    username    String
    day         DateTime
    timeSeconds Decimal

    @@unique([userId, day])
}

view StudentMetric_HourlyLearningTime {
    userId      String
    username    String
    hour        DateTime
    timeSeconds Decimal

    @@unique([userId, hour])
}

view StudentMetric_LearningTimeByCourse {
    userId      String
    username    String
    courseId    String
    courseTitle String
    timeSeconds Decimal

    @@unique([userId, courseId])
}

view StudentMetric_DailyLearningTimeByCourse {
    userId      String
    username    String
    courseId    String
    courseTitle String
    day         DateTime
    timeSeconds Decimal

    @@unique([userId, courseId, day])
}

view StudentMetric_CoursesCompletedBySubject {
    userId                String
    username              String
    subjectId             String
    subjectTitle          String
    completedCoursesCount BigInt
    completedCourses      String?

    @@unique([userId, subjectId])
}

view StudentMetric_LearningStreak {
    userId            String @unique
    username          String
    longestStreakDays BigInt
    currentStreakDays BigInt
}

view StudentMetric_AverageQuizAnswers {
    userId              String
    username            String
    courseId            String
    courseTitle         String
    lessonId            String
    lessonTitle         String
    wrongAnswers        BigInt
    correctAnswers      BigInt
    averageAccuracyRate Decimal

    @@unique([userId, courseId, lessonId])
}

view StudentMetric_HourlyAverageQuizAnswers {
    userId              String
    username            String
    courseId            String
    courseTitle         String
    lessonId            String
    lessonTitle         String
    hour                DateTime
    wrongAnswers        BigInt
    correctAnswers      BigInt
    averageAccuracyRate Decimal

    @@unique([userId, courseId, lessonId, hour])
}
