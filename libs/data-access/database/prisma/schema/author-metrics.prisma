view AuthorMetric_AverageCompletionRate {
    authorId              String  @unique
    authorUsername        String
    averageCompletionRate Decimal
}

view AuthorMetric_AverageSubjectCompletionRate {
    authorId              String
    authorUsername        String
    subjectId             String
    subjectTitle          String
    totalEnrollments      BigInt?
    completedEnrollments  BigInt?
    averageCompletionRate Decimal?

    @@unique([authorId, subjectId])
}

view AuthorMetric_AverageCourseCompletionRate {
    authorId              String
    authorUsername        String
    courseId              String
    courseTitle           String
    totalEnrollments      BigInt
    completedEnrollments  BigInt
    averageCompletionRate Decimal

    @@unique([authorId, courseId])
}

view AuthorMetric_AverageLessonCompletionRate {
    authorId              String
    authorUsername        String
    courseId              String
    courseTitle           String
    lessonId              String
    lessonTitle           String
    usersStarted          BigInt
    usersFinished         BigInt
    averageCompletionRate Decimal

    @@unique([authorId, courseId, lessonId])
}

view AuthorMetric_AverageLessonCompletionRateByCourse {
    authorId                    String
    authorUsername              String
    courseId                    String
    courseTitle                 String
    numLessons                  BigInt
    totalLessonsStarted         BigInt
    totalLessonsFinished        BigInt
    averageCourseCompletionRate Decimal

    @@unique([authorId, courseId])
}
