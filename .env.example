######## Transcription Service ########
# URL of external transcription service used to generate subtitles for video content.
# If not set, transcription features will be disabled.
NEXT_PUBLIC_TRANSCRIPTION_SERVICE_URL="http://localhost:3000"
# If set to true, the system will attempt to migrate existing video content by sending it to the transcription service and updating it with the returned subtitles.
# This is useful if you are adding a transcription service to an existing instance that already has video content without subtitles, i.e., for migration purpose.
NEXT_PUBLIC_TRANSCRIPTION_MIGRATE_EXISTING_VIDEO_CONTENT=true
